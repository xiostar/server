#!/usr/bin/env bash
# Legt das Zugangspasswort für Adressen mit "gate" in domains.conf fest.
#   sudo -u deploy /srv/server/bin/set-gate 'mein langes passwort'
# Ohne Argument: Passwortschutz wieder abschalten.
# Gespeichert wird nur eine Prüfsumme (SHA-256) in /srv/server/.env, nie das Passwort selbst.
set -euo pipefail
cd /srv/server
touch .env
grep -v '^GATE_HASH=' .env >.env.tmp || true
if [[ -n "${1:-}" ]]; then
	hash="$(printf '%s' "$1" | sha256sum | awk '{ print $1 }')"
	printf 'GATE_HASH=%s\n' "$hash" >>.env.tmp
	echo "Passwortschutz eingeschaltet."
else
	echo "Passwortschutz ausgeschaltet."
fi
mv .env.tmp .env
chmod 600 .env
bin/gen-caddy
# .env wird nur beim Neuanlegen des Containers gelesen
docker compose up -d --force-recreate caddy
echo "Fertig. Wer die Seite öffnet, muss das Passwort einmal eingeben (gilt etwa ein Jahr)."
