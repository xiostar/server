#!/usr/bin/env bash
# Erzwungener SSH-Befehl für den GitHub-Actions-Schlüssel (siehe ~deploy/.ssh/authorized_keys).
# Erlaubt ausschließlich "deploy <name>" – keine Shell, kein anderer Befehl.
set -euo pipefail

read -r cmd app extra <<<"${SSH_ORIGINAL_COMMAND:-}" || true

if [[ "${cmd:-}" != deploy || -z "${app:-}" || -n "${extra:-}" || ! "$app" =~ ^[a-z0-9-]+$ ]]; then
	echo "Nicht erlaubt. Nur: deploy <app-name>" >&2
	exit 1
fi

exec /srv/server/bin/deploy "$app"
