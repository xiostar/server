#!/usr/bin/env bash
# Erzeugt aus apps.conf die Proxy-Regeln (caddy/apps.caddy) und die Startseite (caddy/www/index.html),
# aus domains.conf die eigenen Adressen (caddy/hosts.caddy).
# Wird von bin/deploy server und setup.sh aufgerufen. Die erzeugten Dateien stehen nicht im Repo.
set -euo pipefail

dir="$(cd "$(dirname "$0")/.." && pwd)"
conf="$dir/apps.conf"
out="$dir/caddy/apps.caddy"
www="$dir/caddy/www"
mkdir -p "$www"

esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

{
	echo "# Automatisch erzeugt aus apps.conf von bin/gen-caddy – nicht von Hand ändern."
	while read -r name repo _; do
		[[ -z "$name" || "$name" == \#* || -z "${repo:-}" ]] && continue
		[[ "$name" =~ ^[a-z0-9-]+$ ]] || { echo "Ungültiger App-Name in apps.conf: $name" >&2; exit 1; }
		cat <<EOF

redir /$name /$name/
handle /$name/* {
	reverse_proxy $name:8080
}
EOF
	done <"$conf"
} >"$out.tmp"
mv "$out.tmp" "$out"

# Eigene Adressen aus domains.conf: je Adresse ein eigener Site-Block mit HTTPS
hosts="$dir/caddy/hosts.caddy"
gates="$dir/caddy/gate-out"
mkdir -p "$gates"
rm -f "$gates"/*.html

# Zugangspasswörter (nur Prüfsummen) aus .env, gesetzt mit bin/set-gate:
#   GATE_HASH=…         für "gate"        (gemeinsames Passwort, wie bisher)
#   GATE_HASH_NAME=…    für "gate=name"   (eigenes Passwort, z. B. gate=stundenanker)
gate_var() { if [[ -z "$1" ]]; then echo GATE_HASH; else echo "GATE_HASH_$(printf '%s' "$1" | tr 'a-z-' 'A-Z_')"; fi; }
gate_hash() {
	local var
	var="$(gate_var "$1")"
	[[ -f "$dir/.env" ]] || return 0
	sed -n "s/^$var=\([0-9a-f]\{64\}\)\$/\1/p" "$dir/.env" | tail -1
}

# Optionen einer Zeile lesen: gate | gate=name | exklusiv
parse_opts() {
	gate=0 gname="" exkl=0
	local o
	for o in "$@"; do
		case "$o" in
			gate) gate=1 ;;
			gate=*)
				gate=1 gname="${o#gate=}"
				[[ "$gname" =~ ^[a-z0-9-]+$ ]] || { echo "domains.conf: ungültiger Passwort-Name '$gname' (nur a-z, 0-9, -)" >&2; exit 1; }
				;;
			exklusiv) exkl=1 ;;
			\#*) break ;;
			*) echo "domains.conf: unbekannte Option '$o'" >&2; exit 1 ;;
		esac
	done
}

# Apps, die NUR über ihre geschützte Adresse erreichbar sein sollen ("exklusiv"):
# Unter /<name>/ auf der IP bzw. Hauptdomain wird dann auf diese Adresse umgeleitet,
# damit niemand das Passwort über den alten Pfad umgehen kann.
declare -A exclusive=()
if [[ -f "$dir/domains.conf" ]]; then
	while read -r host name rest; do
		[[ -z "$host" || "$host" == \#* || -z "${name:-}" || "$name" == "-" ]] && continue
		# shellcheck disable=SC2086
		parse_opts $rest
		if [[ $exkl == 1 ]]; then
			if [[ $gate == 1 && -z "$(gate_hash "$gname")" ]]; then
				echo "Hinweis: $host ist exklusiv, aber noch ohne Passwort – /$name/ bleibt vorerst offen." >&2
			else
				exclusive[$name]="$host"
			fi
		fi
	done <"$dir/domains.conf"
fi

{
	echo "# Automatisch erzeugt aus domains.conf von bin/gen-caddy – nicht von Hand ändern."
	if [[ -f "$dir/domains.conf" ]]; then
		while read -r host name rest; do
			[[ -z "$host" || "$host" == \#* || -z "${name:-}" ]] && continue
			[[ "$host" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z]{2,}$ ]] || { echo "Ungültige Adresse in domains.conf: $host" >&2; exit 1; }
			# "-" statt App-Name: Adresse zeigt nur eine leere Seite
			if [[ "$name" == "-" ]]; then
				cat <<EOF

$host {
	header Content-Type "text/html; charset=utf-8"
	respond "<!doctype html><title></title>" 200
}
EOF
				continue
			fi
			awk -v n="$name" '$1 == n { found = 1 } END { exit !found }' "$conf" || { echo "domains.conf: App '$name' steht nicht in apps.conf" >&2; exit 1; }
			# shellcheck disable=SC2086
			parse_opts $rest
			# "gate" / "gate=name": erst nach Eingabe des Zugangspassworts (einmalig, Cookie gilt etwa ein Jahr)
			if [[ $gate == 1 ]]; then
				hash="$(gate_hash "$gname")"
				if [[ -z "$hash" ]]; then
					echo "Hinweis: $host soll geschützt werden, aber es ist kein Passwort gesetzt (bin/set-gate${gname:+ -n $gname}). Seite bleibt offen." >&2
				else
					cookie="gate${gname:+_$gname}"
					cookie="${cookie//-/_}"
					# Eigene Passwort-Seite je Cookie-Name (die Vorlage setzt das Cookie im Browser)
					sed "s/__COOKIE__/$cookie/g" "$dir/caddy/gate/gate.html" >"$gates/$cookie.html"
					cat <<EOF

$host {
	encode zstd gzip
	# Ohne Passwort erreichbar: App-Beschreibung und Icons (Browser laden sie ohne Cookie,
	# sonst lässt sich die App nicht installieren) sowie Impressum und Datenschutz.
	@gesperrt {
		not header_regexp Cookie "(^|; ?)$cookie=$hash(;|\$)"
		not path /$name/manifest.webmanifest /$name/icon.svg /$name/icon-192.png /$name/icon-512.png /$name/icon-maskable-512.png /$name/apple-touch-icon.png /$name/impressum /$name/datenschutz
	}
	handle @gesperrt {
		header Cache-Control "no-store"
		root * /etc/caddy/gate-out
		rewrite * /$cookie.html
		file_server
	}
	handle {
		redir / /$name/
		redir /$name /$name/
		handle /$name/* {
			reverse_proxy $name:8080
		}
		handle {
			redir * /$name/
		}
	}
}
EOF
					continue
				fi
			fi
			cat <<EOF

$host {
	encode zstd gzip
	redir / /$name/
	redir /$name /$name/
	handle /$name/* {
		reverse_proxy $name:8080
	}
	handle {
		redir * /$name/
	}
}
EOF
		done <"$dir/domains.conf"
	fi
} >"$hosts.tmp"
mv "$hosts.tmp" "$hosts"

# Exklusive Apps: Pfad auf der IP/Hauptdomain zur eigenen (geschützten) Adresse umleiten
for name in "${!exclusive[@]}"; do
	host="${exclusive[$name]}"
	awk -v n="$name" -v h="$host" '
		$0 == "redir /" n " /" n "/" { print "redir /" n " https://" h "/" n "/"; next }
		$0 == "handle /" n "/* {" { print "redir /" n "/* https://" h "{uri}"; skip = 1; next }
		skip && $0 == "}" { skip = 0; next }
		skip { next }
		{ print }
	' "$out" >"$out.tmp" && mv "$out.tmp" "$out"
done

{
	cat <<'EOF'
<!doctype html>
<html lang="de">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Server</title>
<style>
  :root { color-scheme: light dark; --bg: #f6f6f3; --fg: #1d1f1c; --card: #fff; --line: #e2e2dc; --accent: #2f8f5b; }
  @media (prefers-color-scheme: dark) { :root { --bg: #111412; --fg: #e9e7e0; --card: #1a1f1c; --line: #2b332e; } }
  body { margin: 0; font: 16px/1.5 system-ui, sans-serif; background: var(--bg); color: var(--fg); }
  main { max-width: 40rem; margin: 3rem auto; padding: 0 1rem; }
  h1 { font-size: 1.4rem; }
  ul { list-style: none; padding: 0; display: grid; gap: .6rem; }
  a { display: block; padding: .9rem 1rem; background: var(--card); border: 1px solid var(--line); border-radius: 10px; color: inherit; text-decoration: none; font-weight: 600; }
  a:hover { border-color: var(--accent); }
</style>
<main>
<h1>Server läuft</h1>
<ul>
EOF
	while read -r name repo title; do
		[[ -z "$name" || "$name" == \#* || -z "${repo:-}" ]] && continue
		printf '  <li><a href="/%s/">%s</a></li>\n' "$name" "$(printf '%s' "${title:-$name}" | esc)"
	done <"$conf"
	printf '</ul>\n</main>\n</html>\n'
} >"$www/index.html.tmp"
mv "$www/index.html.tmp" "$www/index.html"
