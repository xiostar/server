#!/usr/bin/env bash
# Erzeugt aus apps.conf die Proxy-Regeln (caddy/apps.caddy) und die Startseite (caddy/www/index.html),
# aus domains.conf die eigenen Adressen (caddy/hosts.caddy).
# Wird von bin/deploy server und setup.sh aufgerufen. Die erzeugten Dateien stehen nicht im Repo.
set -euo pipefail

dir="$(cd "$(dirname "$0")/.." && pwd)"
conf="$dir/apps.conf"
out="$dir/caddy/apps.caddy"
www="$dir/caddy/www"
mkdir -p "$www"

esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

{
	echo "# Automatisch erzeugt aus apps.conf von bin/gen-caddy – nicht von Hand ändern."
	while read -r name repo _; do
		[[ -z "$name" || "$name" == \#* || -z "${repo:-}" ]] && continue
		[[ "$name" =~ ^[a-z0-9-]+$ ]] || { echo "Ungültiger App-Name in apps.conf: $name" >&2; exit 1; }
		cat <<EOF

redir /$name /$name/
handle /$name/* {
	reverse_proxy $name:8080
}
EOF
	done <"$conf"
} >"$out.tmp"
mv "$out.tmp" "$out"

# Eigene Adressen aus domains.conf: je Adresse ein eigener Site-Block mit HTTPS
hosts="$dir/caddy/hosts.caddy"
# Zugangspasswort (nur die Prüfsumme) aus .env, gesetzt mit bin/set-gate
gate_hash=""
if [[ -f "$dir/.env" ]]; then
	gate_hash="$(sed -n 's/^GATE_HASH=\([0-9a-f]\{64\}\)$/\1/p' "$dir/.env" | tail -1)"
fi
{
	echo "# Automatisch erzeugt aus domains.conf von bin/gen-caddy – nicht von Hand ändern."
	if [[ -f "$dir/domains.conf" ]]; then
		while read -r host name opt _; do
			[[ -z "$host" || "$host" == \#* || -z "${name:-}" ]] && continue
			[[ "$host" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z]{2,}$ ]] || { echo "Ungültige Adresse in domains.conf: $host" >&2; exit 1; }
			# "-" statt App-Name: Adresse zeigt nur eine leere Seite
			if [[ "$name" == "-" ]]; then
				cat <<EOF

$host {
	header Content-Type "text/html; charset=utf-8"
	respond "<!doctype html><title></title>" 200
}
EOF
				continue
			fi
			awk -v n="$name" '$1 == n { found = 1 } END { exit !found }' "$conf" || { echo "domains.conf: App '$name' steht nicht in apps.conf" >&2; exit 1; }
			# "gate": erst nach Eingabe des Zugangspassworts (einmalig, Cookie gilt etwa ein Jahr)
			if [[ "${opt:-}" == gate ]]; then
				if [[ -z "$gate_hash" ]]; then
					echo "Hinweis: $host soll geschützt werden, aber es ist kein Passwort gesetzt (bin/set-gate). Seite bleibt offen." >&2
				else
					cat <<EOF

$host {
	encode zstd gzip
	# App-Beschreibung und Icons ohne Passwort: Browser laden sie ohne Cookie (sonst lässt sich die App nicht installieren)
	@gesperrt {
		not header_regexp Cookie "(^|; ?)gate=$gate_hash(;|\$)"
		not path /$name/manifest.webmanifest /$name/icon.svg /$name/icon-192.png /$name/icon-512.png /$name/icon-maskable-512.png /$name/apple-touch-icon.png
	}
	handle @gesperrt {
		header Cache-Control "no-store"
		root * /etc/caddy/gate
		rewrite * /gate.html
		file_server
	}
	handle {
		redir / /$name/
		redir /$name /$name/
		handle /$name/* {
			reverse_proxy $name:8080
		}
		handle {
			redir * /$name/
		}
	}
}
EOF
					continue
				fi
			fi
			cat <<EOF

$host {
	encode zstd gzip
	redir / /$name/
	redir /$name /$name/
	handle /$name/* {
		reverse_proxy $name:8080
	}
	handle {
		redir * /$name/
	}
}
EOF
		done <"$dir/domains.conf"
	fi
} >"$hosts.tmp"
mv "$hosts.tmp" "$hosts"

{
	cat <<'EOF'
<!doctype html>
<html lang="de">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Server</title>
<style>
  :root { color-scheme: light dark; --bg: #f6f6f3; --fg: #1d1f1c; --card: #fff; --line: #e2e2dc; --accent: #2f8f5b; }
  @media (prefers-color-scheme: dark) { :root { --bg: #111412; --fg: #e9e7e0; --card: #1a1f1c; --line: #2b332e; } }
  body { margin: 0; font: 16px/1.5 system-ui, sans-serif; background: var(--bg); color: var(--fg); }
  main { max-width: 40rem; margin: 3rem auto; padding: 0 1rem; }
  h1 { font-size: 1.4rem; }
  ul { list-style: none; padding: 0; display: grid; gap: .6rem; }
  a { display: block; padding: .9rem 1rem; background: var(--card); border: 1px solid var(--line); border-radius: 10px; color: inherit; text-decoration: none; font-weight: 600; }
  a:hover { border-color: var(--accent); }
</style>
<main>
<h1>Server läuft</h1>
<ul>
EOF
	while read -r name repo title; do
		[[ -z "$name" || "$name" == \#* || -z "${repo:-}" ]] && continue
		printf '  <li><a href="/%s/">%s</a></li>\n' "$name" "$(printf '%s' "${title:-$name}" | esc)"
	done <"$conf"
	printf '</ul>\n</main>\n</html>\n'
} >"$www/index.html.tmp"
mv "$www/index.html.tmp" "$www/index.html"
