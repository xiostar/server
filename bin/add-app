#!/usr/bin/env bash
# Legt für eine App aus apps.conf einen Deploy-Key an und zeigt ihn an.
# Als Benutzer "deploy" ausführen:   sudo -u deploy /srv/server/bin/add-app <name>
# Wird auch von setup.sh für alle Apps benutzt.
set -euo pipefail

name="${1:?Aufruf: add-app <name>}"
conf="$(dirname "$0")/../apps.conf"
repo="$(awk -v n="$name" '$1 == n { print $2 }' "$conf")"
[[ -n "$repo" ]] || { echo "'$name' steht nicht in apps.conf" >&2; exit 1; }

"$(dirname "$0")/_ensure-deploy-key" "$name" "$repo"
